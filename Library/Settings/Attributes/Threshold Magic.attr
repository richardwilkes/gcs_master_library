			"id": "tm_calamity_bonus",
			"type": "integer",
			"name": "Calamity Bonus",
			"full_name": "Calamity Roll Bonus",
			"base": "signedValue(Math.floor($tm_excess / iff(entity.traitLevel(\"Safer Magical Excess\") >= 1, Math.round(<error>), 5)))"
		}
