		{
			"id": "tm_excess",
			"type": "integer",
			"name": "Excess PT",
			"full_name": "Excess Power Tally",
			"base": "iff($tm_pt > $tm_threshold, Math.floor($tm_pt - $tm_threshold), 0)"
		},
