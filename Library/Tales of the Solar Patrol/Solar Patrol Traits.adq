		{
			"id": "tzhIlrvzROZuwiIN2",
			"name": "Code of Honor (Solar Patrolman's)",
			"reference": "TSP38,B127",
			"reference_highlight": "Code of Honor",
			"local_notes": "The mission is everything. Never abandon a comrade unless the mission demands it. Never take an innocent life if there is any alternative that allows completion of the mission, including sacrificing your own. Accept an honorable surrender. Women and children first! Treat prisoners fairly. Obey the law. Tell the truth. Fight bravely. Respect and honor the traditions of the Patrol.",
			"tags": [
				"Disadvantage",
				"Mental"
			],
			"base_points": -15,
			"calc": {
				"points": -15
			}
		},
		{
			"id": "tajd4X3UXgxun5R3Z",
			"name": "Code of Honor (Naturalist's)",
			"reference": "TSP38,B127",
			"reference_highlight": "Code of Honor",
			"local_notes": "Treat the wilderness with respect; do not exploit either natives or animals; respect the traditions of the species you encounter; kill animals only in self defense or for food, never for sport.",
			"tags": [
				"Disadvantage",
				"Mental"
			],
			"base_points": -5,
			"calc": {
				"points": -5
			}
		},
		{
			"id": "tndtXPotzR1JbAR8D",
			"name": "Code of Honor (Trader's)",
			"reference": "TSP38,B127",
			"reference_highlight": "Code of Honor",
			"local_notes": "Fulfill the letter of the contract. Do not use force against a competitor – just out-bargain them! No mercy for pirates or raiders. Never tell an outright lie about your goods, but selective omissions are acceptable.",
			"tags": [
				"Disadvantage",
				"Mental"
			],
			"base_points": -5,
			"calc": {
				"points": -5
			}
		},
		{
			"id": "tpFUt7c2oIk1MbE0B",
			"name": "Code of Honor (Villain's)",
			"reference": "TSP38,B127",
			"reference_highlight": "Code of Honor",
			"local_notes": "Honor your word if it is freely given – so long as you are not betrayed! Treat a skilled opponent with respect. Grant a swift and merciful death to a fallen foe. Let no insult go unavenged. Never allow a traitor to live!",
			"tags": [
				"Disadvantage",
				"Mental"
			],
			"base_points": -5,
			"calc": {
				"points": -5
			}
		},
