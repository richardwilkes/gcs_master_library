				{
					"id": "tnFolQJBxwRHRiskk",
					"name": "Damage Resistance",
					"reference": "DW88",
					"modifiers": [
						{
							"id": "mTWIN7A40KjermhUy",
							"name": "Can't wear armor",
							"local_notes": "Your body is designed in such a way that you cannot practically wear personal armour. Reduce cost by 2 points/level.",
							"cost_adj": "-40%"
						},
						{
							"id": "mXCIeiob0NLrK44ez",
							"name": "@Against form@",
							"local_notes": "Damage Resistance that only works against specific forms of attack has a price reduction, depending on how common the threat is. Two possibilities are “Only vs. Heat and Fire” (which also protects against lightning) and “Only vs. Impaling Damage”; both reduce cost by 2 points/level",
							"cost_adj": "-40%",
							"disabled": true
						},
						{
							"id": "msvTg7WnMhF1oVYCq",
							"name": "Tough Skin",
							"local_notes": "Your DR isn’t rigid, leaving you vulnerable to being slowly squeezed or crushed. Furthermore, if a poisoned or drugged weapon, or some other exotic attack such as a stunning electrical blast, strikes your skin, the poison, drug, shock, etc., has full effect, even if your DR saves you from actual injury. Reduce cost by 2 points/level.",
							"cost_adj": "-40%",
							"disabled": true
						}
					],
					"points_per_level": 5,
